# Plantilla de variables de entorno. Se copia a `.env.local` y se rellena:
#
#     cp .env.example .env.local
#
# Aquí sólo van los NOMBRES. Los valores no se suben nunca: `.env*` está en
# .gitignore y este es el único fichero de la familia que se versiona. De dónde
# sale cada valor, y qué pasa si falta, está en docs/ENTORNO.md.

# Base de datos. En local la da `sudo ./scripts/preparar-bbdd.sh`; en Vercel, la
# pestaña «Transaction pooler» del botón Connect de Supabase.
DATABASE_URL=

# Supabase: la URL del proyecto y la clave pública (salen juntas).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave service_role. Hace falta para subir fotos y documentos. Salta toda la
# RLS: nunca con prefijo NEXT_PUBLIC_ ni en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# El dominio de la web, con su esquema (https://…). Con él se construyen los
# enlaces de los correos y las imágenes de vista previa.
NEXT_PUBLIC_SITE_URL=

# El acuse de recibo del RSVP (Resend). Sin clave no se manda, y no es un error.
RESEND_API_KEY=
CORREO_REMITENTE=
# Sólo para los tests: otra dirección a la que mandar las peticiones de Resend.
RESEND_URL=

# Observabilidad. Sin clave no arranca nada.
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
